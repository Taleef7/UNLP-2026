        "2": "\u041d\u0430 \u043e\u0441\u043d\u043e\u0432\u0456 \u043d\u0430\u0434\u0430\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443, \u0434\u043e\u0446\u0456\u043b\u044c\u043d\u0456\u0441\u0442\u044c \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043d\u0430\u043f\u0456\u0432\u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0435\u043d\u0456\u0446\u0438\u043b\u0456\u043d\u0443 \u0448\u0438\u0440\u043e\u043a\u043e\u0433\u043e \u0441\u043f\u0435\u043a\u0442\u0440\u0430 \u0434\u0456\u0457, \u0442\u0430\u043a\u043e\u0433\u043e \u044f\u043a \u041f\u0456\u043f\u0435\u0440\u0430\u0446\u0438\u043b\u0456\u043d-\u0422\u0430\u0437\u043e\u0431\u0430\u043a\u0442\u0430\u043c-\u0422\u0435\u0432\u0430, \u0441\u043b\u0456\u0434 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0442\u0438 \u0437 \u0443\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u043a\u0456\u043b\u044c\u043a\u043e\u0445 \u0444\u0430\u043a\u0442\u043e\u0440\u0456\u0432.\n\n1. **\u0412\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u044f \u0437 \u0456\u043d\u0448\u0438\u043c\u0438 \u043b\u0456\u043a\u0430\u043c\u0438:** \u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043f\u0456\u0434\u043a\u0440\u0435\u0441\u043b\u044e\u0454 \u0432\u0430\u0436\u043b\u0438\u0432\u0456\u0441\u0442\u044c \u0432\u0440\u0430\u0445\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0437\u0430\u0454\u043c\u043e\u0434\u0456\u0457 \u0437 \u0456\u043d\u0448\u0438\u043c\u0438 \u043f\u0440\u0435\u043f\u0430\u0440\u0430\u0442\u0430\u043c\u0438,",
        "3": "\u0417\u0433\u0456\u0434\u043d\u043e \u0437 \u043d\u0430\u0434\u0430\u043d\u0438\u043c \u0442\u0435\u043a\u0441\u0442\u043e\u043c, \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u0442\u0430\u0439\u043c-\u0430\u0443\u0442\u0443 \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0442\u043e\u0433\u043e, \u0447\u0438 \u0454 \u0446\u0435 \u043c\u0435\u0434\u0456\u0439\u043d\u0438\u0439 \u0442\u0430\u0439\u043c-\u0430\u0443\u0442, \u0456 \u0432 \u044f\u043a\u0456\u0439 \u0447\u0432\u0435\u0440\u0442\u0456 \u0432\u0456\u043d \u0431\u0435\u0440\u0435\u0442\u044c\u0441\u044f.\n\n- \u041f\u0435\u0440\u0448\u0438\u0439 \u0442\u0430\u0439\u043c-\u0430\u0443\u0442 \u0443 \u043a\u043e\u0436\u043d\u0456\u0439 \u0447\u0432\u0435\u0440\u0442\u0456 (\u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u0430\u0431\u043e \u043c\u0435\u0434\u0456\u0430) \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044e 60, 75, 90 \u0430\u0431\u043e 100 \u0441\u0435\u043a\u0443\u043d\u0434.\n- \u0423\u0441\u0456 \u0456\u043d\u0448\u0456 \u0442\u0430\u0439\u043c-\u0430\u0443\u0442\u0438 \u0432 \u0447\u0432\u0435\u0440\u0442\u0456 \u043f\u043e\u0432\u0438\u043d\u043d\u0456 \u0431\u0443\u0442\u0438 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044e 60 \u0441\u0435\u043a\u0443\u043d\u0434.\n\n\u041e\u0441\u043a\u0456\u043b\u044c\u043a\u0438",
        "4": "1. \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0454\u043c\u043e \u043d\u0430\u0434\u0430\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442.\n2. \u0428\u0443\u043a\u0430\u0454\u043c\u043e \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u043f\u0440\u043e \u0444\u0435\u043d\u0456\u0440\u0430\u043c\u0456\u043d\u0443 \u043c\u0430\u043b\u0435\u0430\u0442.\n3. \u0417\u0433\u0456\u0434\u043d\u043e \u0437 \u0442\u0435\u043a\u0441\u0442\u043e\u043c, \u0444\u0435\u043d\u0456\u0440\u0430\u043c\u0456\u043d\u0443 \u043c\u0430\u043b\u0435\u0430\u0442 \"\u0437\u0430\u0431\u0435\u0437\u043f\u0435\u0447\u0443\u0454 \u0434\u0435\u0441\u0435\u043d\u0441\u0438\u0431\u0456\u043b\u0456\u0437\u0443\u044e\u0447\u0443 \u0434\u0456\u044e, \u0449\u043e \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0454\u0442\u044c\u0441\u044f \u0437\u043c\u0435\u043d\u0448\u0435\u043d\u043d\u044f\u043c \u0437\u0430\u043f\u0430\u043b\u044c\u043d\u043e\u0457 \u0440\u0435\u0430\u043a\u0446\u0456\u0457 \u0441\u043b\u0438\u0437\u043e\u0432\u0438\u0445 \u043e\u0431\u043e\u043b\u043e\u043d\u043e\u043a \u0432\u0435\u0440\u0445\u043d\u0456\u0445 \u0434\u0438\u0445\u0430\u043b\u044c\u043d\u0438\u0445 \u0448\u043b\u044f\u0445\u0456\u0432 (\u043f\u043e\u043b\u0456\u043f\u0448\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u043e\u0441\u043e\u0432\u0435 \u0434\u0438\u0445\u0430\u043d\u043d\u044f, \u0437\u043c\u0435\u043d\u0448\u0443\u0454\u0442\u044c\u0441\u044f \u043d\u0435\u0436\u0438\u0442\u044c, \u0447\u0445\u0430\u043d\u043d\u044f \u0442\u0430 \u0441\u043b\u044c"
      }
